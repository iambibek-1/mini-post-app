<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Post</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-md">
      <!-- Create Post Card -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <!-- Header -->
        <div
          class="bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-5 text-white"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div
                class="h-11 w-11 rounded-full bg-white/20 flex items-center justify-center text-lg font-bold"
              >
                <%= user.name.charAt(0).toUpperCase() %>
              </div>

              <div>
                <h1 class="text-lg font-bold"><%= user.name %></h1>

                <p class="text-xs text-indigo-100">Create a new post</p>
              </div>
            </div>

            <!-- Logout -->
            <a
              href="/logout"
              class="text-sm px-4 py-2 rounded-lg bg-white/20 hover:bg-white/30 transition"
            >
              Logout
            </a>
          </div>
        </div>

        <!-- Form -->
        <div class="p-5">
          <form action="/posts/create" method="POST" class="space-y-4">
            <textarea
              name="content"
              rows="4"
              placeholder="What's on your mind?"
              class="w-full resize-none rounded-xl border border-gray-300 px-4 py-3 text-sm outline-none focus:ring-4 focus:ring-indigo-200 focus:border-indigo-500 transition"
            ></textarea>

            <div class="flex items-center justify-between">
              <p class="text-xs text-gray-500">Your post will be public</p>

              <button
                type="submit"
                class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-sm font-semibold shadow hover:scale-[1.02] active:scale-[0.98] transition"
              >
                Post
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Demo Posts -->
      <div class="mt-6 space-y-4">
        <!-- Post Card -->
        <% user.posts.reverse().forEach((post)=>{ %>

        <div class="bg-white rounded-2xl shadow-md p-5">
          <div class="flex items-center gap-3 mb-3">
            <div
              class="h-10 w-10 rounded-full bg-indigo-500 text-white flex items-center justify-center font-bold"
            >
              <%= user.name.charAt(0).toUpperCase() %>
            </div>

            <div class="flex w-full justify-between">
              <h2 class="font-semibold text-gray-800"><%= user.username %></h2>
              <p class="text-xs text-gray-500"></p>
              <div>
                <a href="/delete/<%=post._id%>" class="text-xs">🗑️</a>
              </div>
            </div>
          </div>

          <p class="text-gray-700 text-sm leading-relaxed">
            <%= post.content %>
          </p>
          <small><%= post.likes.length %> likes</small>
          <div class="flex items-center gap-6 mt-4 text-sm text-gray-500">
            <a
              href="/like/<%= post._id %>"
              class="hover:text-indigo-600 transition"
            >
              <%= post.likes.indexOf(user._id) === -1 ? "❤️ Like" : "💔Unlike"%>
            </a>
            <a
              href="/edit/<%=post._id %>"
              class="hover:text-indigo-600 transition"
              >✏️ Edit</a
            >
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </body>
</html>
