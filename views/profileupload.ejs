<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload Profile Picture</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body
    class="bg-gradient-to-br from-slate-100 via-gray-100 to-slate-200 flex items-center justify-center min-h-screen px-4"
  >
    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl p-8">
      <h1 class="text-2xl font-bold text-center text-gray-800 mb-2">
        Upload Profile Picture
      </h1>

      <p class="text-sm text-gray-500 text-center mb-6">
        Choose an image to update your profile
      </p>

      <form
        action="/upload"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-5"
      >
        <!-- File Input -->
        <div>
          <label
            for="file"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Select Image
          </label>

          <input
            type="file"
            id="file"
            name="file"
            class="w-full border border-gray-300 rounded-2xl px-4 py-3 text-sm file:mr-4 file:px-4 file:py-2 file:rounded-xl file:border-0 file:bg-indigo-100 file:text-indigo-700 hover:file:bg-indigo-200 transition"
          />
        </div>

        <!-- Button -->
        <button
          type="submit"
          class="w-full py-3 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-semibold shadow-lg hover:scale-[1.02] active:scale-[0.98] transition"
        >
          Upload
        </button>
      </form>
    </div>
  </body>
</html>
